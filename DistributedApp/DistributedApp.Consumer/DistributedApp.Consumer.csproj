<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ProcessedMessageStore.cs" />
    <Compile Include="ConsumerStateFiles.cs" />
    <ProjectReference Include="..\DistributedApp.Contracts\DistributedApp.Contracts.csproj" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Google.Protobuf" Version="3.27.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
    <Protobuf Include="..\DistributedApp.Broker\Protos\broker.proto" Link="Protos\broker.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>
